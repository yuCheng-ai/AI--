# Run ./scripts/dev-init.sh to create .env with fresh random passwords.
# This example intentionally has no usable default password.
DRAMA_DB_PASSWORD=''
DRAMA_DB_APP_PASSWORD=''
DRAMA_BOOTSTRAP_USERNAME='admin'
DRAMA_BOOTSTRAP_PASSWORD=''
DRAMA_DB_URL='jdbc:postgresql://127.0.0.1:15432/drama'
DRAMA_HTTP_PORT='18080'
# dev-init.sh writes an absolute path for local Java and Docker to share.
DRAMA_STORAGE_ROOT=''
# Container processes use the owner of the local media directory.
DRAMA_UID='10001'
DRAMA_GID='10001'
# Optional: set an installed JDK 25 directory when auto-detection is insufficient.
# DRAMA_JAVA_HOME='/absolute/path/to/jdk-25'

# Optional development settings. Both local Java and Compose use these values.
# DRAMA_UPLOAD_MAX_FILE_SIZE='100MB'
# DRAMA_UPLOAD_MAX_REQUEST_SIZE='101MB'
# DRAMA_DB_POOL_MAX='10'
# DRAMA_DB_POOL_MIN='2'
# DRAMA_SQL_SLOW_THRESHOLD_MS='300'
# DRAMA_DOCS_ENABLED='true'
# DRAMA_DOCS_PUBLIC='true'
# DRAMA_COOKIE_SECURE='false'
# DRAMA_BOOTSTRAP_ENABLED='true'
